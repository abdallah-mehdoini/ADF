{
	"name": "PL_ControlFlow",
	"properties": {
		"activities": [
			{
				"name": "Switch1",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Get  Output File",
						"dependencyConditions": [
							"Skipped"
						]
					}
				],
				"typeProperties": {
					"on": {
						"value": "@activity('Get  Output File').output.contentMD5",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Folder"
						},
						{
							"value": "File"
						}
					]
				}
			},
			{
				"name": "Get  Output File",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_Formation",
						"type": "DatasetReference"
					},
					"fieldList": [],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"annotations": []
	}
}